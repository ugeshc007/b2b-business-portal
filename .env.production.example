NODE_ENV="production"
DATABASE_URL="file:./prisma/prod.db"
JWT_SECRET="replace-with-random-64-character-secret-before-production"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="replace-with-strong-password"
API_PORT="4321"
VITE_API_URL="https://your-domain.example"
APP_ORIGIN="https://your-domain.example"
TRUST_PROXY="true"
LOG_RETENTION_DAYS="14"
APP_TIME_ZONE="Asia/Dubai"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.example/api/email-integrations/oauth/callback"
GMAIL_TOKEN_ENCRYPTION_KEY="replace-with-random-32-character-minimum-key"
